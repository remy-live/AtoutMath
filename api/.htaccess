# L'EN-TÊTE D'AUTORISATION DOIT PARVENIR À PHP — et il n'y parvient pas tout seul.
#
# C'EST LE DÉFAUT LE PLUS COÛTEUX QU'AIT CONNU CE LOGICIEL, et il ne se voyait
# nulle part. Quand PHP tourne en CGI, FastCGI ou php-fpm — ce qui est le cas de
# la quasi-totalité des hébergements mutualisés, et de celui de Rémy (« PHP
# 8.2.31 fpm-fcgi », dit son rapport) —, Apache GARDE l'en-tête `Authorization`
# pour son propre système d'authentification et ne le transmet pas.
#
# Conséquence exacte : on se connecte très bien — le mot de passe voyage dans le
# CORPS de la requête, aucun en-tête n'est nécessaire —, on reçoit un jeton, et
# TOUT appel suivant est refusé par 401. Le professeur lit « identifiez-vous »
# à la seconde où il vient de s'identifier ; l'élève se rattache, travaille, et
# sa synchronisation échoue en silence.
#
# TROIS FAÇONS DE LE RÉPARER, ET ON LES POSE TOUTES LES TROIS. Elles ne
# dépendent pas des mêmes modules ni des mêmes versions d'Apache, et l'on ne
# sait pas d'avance ce que l'hébergeur a activé. Aucune ne gêne les autres.
#
# On N'utilise PAS `CGIPassAuth On`, qui serait pourtant la façon moderne : il
# exige `AllowOverride AuthConfig`, et sur un hébergement qui ne l'accorde pas
# Apache répond 500 sur TOUT le dossier. Un réglage qui peut éteindre l'API
# n'est pas un réglage qu'on pose sans pouvoir l'essayer.
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Toutes les routes passent par index.php.
RewriteEngine On

# La seconde façon : recopier l'en-tête dans une variable d'environnement.
# Selon le module qui parle à PHP, elle ressort en `HTTP_AUTHORIZATION` ou en
# `REDIRECT_HTTP_AUTHORIZATION` — `bearerToken()` lit les deux.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# CE QUI NE DOIT JAMAIS ÊTRE SERVI.
#
#   · config.php contient le secret de signature et, en MySQL, le mot de passe
#     de la base ;
#   · les fichiers .sql et .sqlite SONT la base — un GET dessus, et l'on repart
#     avec les prénoms de la classe et tout son travail. C'est le danger propre
#     à l'installation « un fichier », et c'est ici qu'on le ferme. Le dossier
#     api/data/ porte en plus son propre .htaccess, et le fichier un nom tiré
#     au hasard : voir protegerDossier() dans install.php.
#   · .derniere-purge est le témoin de la purge quotidienne.
<FilesMatch "^(config\.php|\.derniere-purge|_.*\.php|.*\.(sql|sqlite|sqlite-wal|sqlite-shm|db))$">
    Require all denied
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Les dossiers qui ne contiennent aucun point d'entrée. Redondant avec le
# .htaccess déposé dans chacun, et c'est voulu : deux verrous valent mieux
# qu'un sur les fichiers qu'on ne doit jamais servir.
RedirectMatch 403 ^.*/(lib|tools)/.*$

# Le dossier des données, refusé dans son entier. Redondant avec le .htaccess
# qu'install.php y dépose, et c'est voulu : si le dossier est recréé à la main,
# la protection tient quand même.
RedirectMatch 403 ^.*/data/.*$

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "same-origin"
</IfModule>
